<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>라벨 <%= count %>장 — 폼텍 3218</title>
<link rel="stylesheet" href="<%= base %>/static/css/labels.css">
<style>
  .label { width: <%= S.w %>mm; height: <%= S.h %>mm; }
  <% for (let r = 0; r < S.rows; r++) for (let c = 0; c < S.cols; c++) { %>
  .p<%= r * S.cols + c %> { top: <%= (S.top + r * S.pitchY).toFixed(2) %>mm; left: <%= (S.left + c * S.pitchX).toFixed(2) %>mm; }
  <% } %>
</style>
</head>
<body>
<div class="toolbar">
  라벨 <b><%= count %></b>장 · A4 <%= pages.length %>쪽
  <button onclick="print()">인쇄</button>
  <label><input type="checkbox" onchange="document.body.classList.toggle('guide', this.checked)"> 칸 테두리 보기(시험 인쇄용)</label>
</div>
<% pages.forEach((cells) => { %>
<section class="sheet">
  <% cells.forEach((it, i) => { if (!it) return; const a = it.a; %>
  <div class="label p<%= i %>">
    <div class="org"><%= config.orgName %></div>
    <div class="body">
      <table>
        <tr><th>관리번호</th><td class="id"><%= a.id %></td></tr>
        <tr><th>품명</th><td class="nm"><%= a.name %></td></tr>
        <tr><th>취득일자</th><td><%= a.purchase_date %></td></tr>
        <tr><th>관리부서</th><td><%= a.dept %></td></tr>
      </table>
      <div class="qr"><%- it.qr %></div>
    </div>
  </div>
  <% }) %>
</section>
<% }) %>
</body>
</html>
